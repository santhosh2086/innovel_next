# Where Next.js forwards /api/* requests (the Express backend in ../backend).
BACKEND_URL=http://localhost:3001

# Public URL of the site (used for canonical/OpenGraph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the enquiry endpoint. Leave unset to use /api/enquiries (proxied to BACKEND_URL).
# NEXT_PUBLIC_ENQUIRY_ENDPOINT=
